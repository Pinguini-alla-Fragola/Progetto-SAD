@startuml PICUS_V2_WebTier
title PICUS · C&C Runtime · Vista 2 · Dettaglio Web Tier (Porte, Lollipop & Socket)
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam nodesep 56
skinparam ranksep 62
skinparam ArrowColor #475569
skinparam ArrowThickness 1.6

skinparam component {
  BackgroundColor #E9F2FC
  BorderColor #5480B0
  FontColor #143C65
  MinimumWidth 162
}
skinparam component<<subsystem>> {
  BackgroundColor #F7FAFE
  BorderColor #5480B0
  FontColor #143C65
}
skinparam component<<security>> {
  BackgroundColor #E8EEF9
  BorderColor #3B6291
  FontColor #142B46
  MinimumWidth 230
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #1A4A3C
  FontColor #1A4A3C
}
skinparam port {
  BackgroundColor #FFFFFF
  BorderColor #1E293B
}

' ───────────── LIVELLO 0: INTERFACCIA ESTERNA IN INGRESSO ─────────────
interface "IWebAccess [HTTPS / TLS 1.3]" as I_WEB

' ───────────── SOTTOSISTEMA WEB TIER ─────────────
component "Web Tier · Sicurezza, Routing & Controller MVC" as WEB <<subsystem>> {
  portin " " as pWebHttps
  portout " " as pWebUtenze
  portout " " as pWebCatalogo
  portout " " as pWebRichieste
  portout " " as pWebComun
  portout " " as pWebMonit

  ' LIVELLO 1: SICUREZZA & SESSIONE (Asse centrale)
  component "Security Filter Chain\nSessione & Autorizzazione Ruoli\n(OPT · Banco · Operatori)" as SEC <<security>> {
    portin " " as pSecIn
    portout " " as pSecOut
  }

  ' LIVELLO 2: INTERFACCIA CATENA FILTRI
  interface "IFilterChain [Servlet Pipeline]" as I_FILTER

  ' LIVELLO 3: FRONT CONTROLLER & VALIDAZIONE (Asse centrale)
  component "Front Controller (Dispatcher)\nRouting HTTP, Validazione Input\n& Rendering Viste HTML" as DISP <<security>> {
    portin " " as pDispIn
    portout " " as pDispCtrl
  }

  ' LIVELLO 4: INTERFACCIA DISPATCH MVC
  interface "IHandlerExecution [MVC Dispatch · DTO]" as I_MVC

  ' LIVELLO 5: CONTROLLER MVC DEI 5 MODULI
  component "UtenzeController\n[M1] Utenze\nLogin · Attivazione" as C_UTENZE {
    portin " " as pCUtenzeIn
    portout " " as pCUtenzeOut
  }

  component "CatalogoController\n[M2] Catalogo\nMisure · Comuni" as C_CAT {
    portin " " as pCCatIn
    portout " " as pCCatOut
  }

  component "RichiesteController\n[M3] Richieste\nInvio · Elenco · Coda" as C_RICH {
    portin " " as pCRichIn
    portout " " as pCRichOut
  }

  component "ComunicazioniController\n[M4] Comunicazioni\nInvii · Allegati" as C_COM {
    portin " " as pCComIn
    portout " " as pCComOut
  }

  component "MonitoraggioController\n[M5] Monitoraggio\nSchede Trimestrali" as C_MON {
    portin " " as pCMonIn
    portout " " as pCMonOut
  }

  ' Ordinamento orizzontale dei 5 controller
  C_UTENZE -[hidden]right- C_CAT
  C_CAT -[hidden]right- C_RICH
  C_RICH -[hidden]right- C_COM
  C_COM -[hidden]right- C_MON

  ' ─── FLUSSO TOP-DOWN INTERNO ───
  pWebHttps -down-> pSecIn : <<delegate>>

  pSecOut -down-( I_FILTER
  pDispIn -up- I_FILTER

  pDispCtrl -down-( I_MVC
  pCUtenzeIn -up- I_MVC
  pCCatIn -up- I_MVC
  pCRichIn -up- I_MVC
  pCComIn -up- I_MVC
  pCMonIn -up- I_MVC

  pCUtenzeOut -down-> pWebUtenze : <<delegate>>
  pCCatOut -down-> pWebCatalogo : <<delegate>>
  pCRichOut -down-> pWebRichieste : <<delegate>>
  pCComOut -down-> pWebComun : <<delegate>>
  pCMonOut -down-> pWebMonit : <<delegate>>
}

' ───────────── LIVELLO 6: INTERFACCE ESTERNE IN USCITA ─────────────
interface "IUtenzeApi" as I_UTENZE
interface "ICatalogoApi" as I_CATALOGO
interface "IRichiesteApi" as I_RICHIESTE
interface "IComunicazioniApi" as I_COMUNICAZIONI
interface "IMonitoraggioApi" as I_MONITORAGGIO

I_UTENZE -[hidden]right- I_CATALOGO
I_CATALOGO -[hidden]right- I_RICHIESTE
I_RICHIESTE -[hidden]right- I_COMUNICAZIONI
I_COMUNICAZIONI -[hidden]right- I_MONITORAGGIO

' Connessioni sul confine del sottosistema
pWebHttps -up- I_WEB : <<role>> server

pWebUtenze -down-( I_UTENZE
pWebCatalogo -down-( I_CATALOGO
pWebRichieste -down-( I_RICHIESTE
pWebComun -down-( I_COMUNICAZIONI
pWebMonit -down-( I_MONITORAGGIO

legend bottom
  <b>Gerarchia Top-Down:</b> dorsale verticale centrata su <i>Security Filter Chain</i> e <i>Front Controller</i> con fan-out simmetrico sui 5 Controller MVC.
  <b><<delegate>></b> = instradamento tra porta di confine e porta interna con lo stesso ruolo · Scambio esclusivo di <b>DTO</b> verso il livello di dominio.
end legend
@enduml