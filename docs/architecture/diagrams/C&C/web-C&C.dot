digraph PICUS {
// Palette condivisa con le viste MVC, Module&Package e Deployment.
// DOT fissa le righe della griglia e usa solo connettori ortogonali.
graph [fontname="Arial", fontsize=19, fontcolor="#172B3A", bgcolor="white",
       rankdir=TB, splines=ortho, nodesep=0.48, ranksep=0.65, pad=0.22,
       compound=true, newrank=true];
node [shape=component, style="filled", fontname="Arial", fontsize=13,
      margin="0.18,0.14", penwidth=1.2, color="#568573",
      fillcolor="#EDF5F0", fontcolor="#1A4A3C"];
edge [color="#64748B", penwidth=1.2, arrowsize=0.7,
      fontname="Arial", fontsize=11, fontcolor="#334155"];

label="PICUS · Componenti e connettori\nVista 2 · Web Tier";
labelloc=t;

HTTP [shape=box, label="Richiesta HTTP\nHTML / JSON", group=main,
      color="#94A3B8", fillcolor="#F1F5F9", fontcolor="#142B46"];
subgraph cluster_web {
  label="Web Tier · Sicurezza, adattatori HTTP e presentazione";
  fontsize=15; color="#5480B0"; bgcolor="#F7FAFE"; margin=24;
  SEC [label="Spring Security\nAutenticazione · Sessione · CSRF\nPermessi sulle funzioni", group=main,
       color="#5480B0", fillcolor="#E9F2FC", fontcolor="#143C65"];
  MVC [label="Spring MVC\nDispatcherServlet · HandlerAdapter\nRouting, binding e validazione", group=main,
       color="#5480B0", fillcolor="#E9F2FC", fontcolor="#143C65"];
  RESPONSE [label="Presentazione\nViewResolver / Thymeleaf → HTML\nHttpMessageConverter → JSON",
            color="#8069AE", fillcolor="#F2EEFC", fontcolor="#423069"];
  {rank=same; MVC; RESPONSE;}
  SEC -> MVC [xlabel="W2", minlen=2];
  MVC -> RESPONSE [xlabel="W4", minlen=2];
  subgraph cluster_handlers {
    label="Adattatori HTTP dei moduli · Un handler selezionato per richiesta";
    fontsize=13; color="#7C9BB9"; bgcolor="#FFFFFF"; margin=20;
    node [color="#5480B0", fillcolor="#E9F2FC", fontcolor="#143C65"];
    H_IN [shape=point, width=0, height=0, label="", style=invis, group=main];
    C1 [label="M1 · Web Utenze\nArea e CSRF\nGestione [prevista]"];
    C2 [label="M2 · Web Catalogo\nConsultazione JSON\nGestione [prevista]"];
    C3 [label="M3 · Web Richieste\nInvio · Coordinamento\nDisponibilità", group=main];
    C4 [label="M4 · Web Comunicazioni\nAvvisi in-app JSON\nGenerali [previste]"];
    C5 [label="M5 · Web Monitoraggio\nConteggi e schede\n[previsto]", style="filled,dashed",
        color="#946728", fillcolor="#FFF8EA", fontcolor="#563C17"];
    H_OUT [shape=point, width=0, height=0, label="", style=invis, group=main];
    {rank=same; C1; C2; C3; C4; C5;}
    C1 -> C2 -> C3 -> C4 -> C5 [style=invis];
    H_IN -> C3 [style=invis];
    C3 -> H_OUT [style=invis];
  }
  MVC -> H_IN [lhead=cluster_handlers, xlabel="W3", minlen=2];
}
CORE [label="Core Services\nAPI Java dei moduli · Vista 3", group=main];
HTTP -> SEC [lhead=cluster_web, xlabel="W1", minlen=2];
H_OUT -> CORE [ltail=cluster_handlers, xlabel="W5", minlen=2];
SEC -> CORE [xlabel="W6", constraint=false];
LEGEND [shape=plain, fontcolor="#183957", label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#7C9BB9" BGCOLOR="#F7FAFE">
<TR><TD ALIGN="LEFT">W1: ingresso HTTP. W2: prosecuzione della catena Servlet dopo i controlli di sicurezza.</TD></TR>
<TR><TD ALIGN="LEFT">W3: Spring MVC seleziona un handler; la chiamata restituisce un risultato o un errore.</TD></TR>
<TR><TD ALIGN="LEFT">W4: modello e nome vista per HTML, oppure DTO da convertire in JSON; anche redirect ed esiti senza corpo.</TD></TR>
<TR><TD ALIGN="LEFT">W5: invocazione delle API del Core con DTO e identità verificata. W6: UtenzeApi, credenziali e account attivo.</TD></TR>
<TR><TD ALIGN="LEFT">Spring Security gestisce login/logout. I casi d'uso verificano titolarità e assegnazione delle risorse.</TD></TR>
<TR><TD ALIGN="LEFT">Parti previste: quelle etichettate e le viste Richieste che compongono dati di Utenze e Catalogo.</TD></TR>
</TABLE>>];
CORE -> LEGEND [style=invis];

}
