---
title: "PICUS · Stati della richiesta {protocol}"
config:
  theme: base
  look: classic
  htmlLabels: false
  state:
    nodeSpacing: 48
    rankSpacing: 30
    minNodeWidth: 132
    wrappingWidth: 200
  themeCSS: |
    .edgeLabel .label rect { opacity: 1; }
    .edgeLabel text { font-size: 13px; }
    .node.statediagram-state rect, .statediagram-cluster rect.outer { rx: 0px !important; ry: 0px !important; }
    .statediagram-state .text-inner-tspan { font-weight: 700; }
    .statediagramTitleText { font-size: 18px; font-weight: 700; fill: #172B3A; }
    .statediagram-cluster rect { stroke: #7C9BB9; }
    .cluster-label text { fill: #183957; }
    /* Colori dei badge in picus.css e integrazione-ui.css. */
    .node[id*="-Creata-"] { --stato-sfondo: #e6eef0; --stato-testo: #253f4c; }
    .node[id*="-Carico-"], .node[id*="-Programmazione-"] { --stato-sfondo: #fbedd6; --stato-testo: #795117; }
    .node[id*="-Confermata-"] { --stato-sfondo: #e8f2e9; --stato-testo: #192c3a; }
    .node[id*="-Rifiutata-"] { --stato-sfondo: #faecee; --stato-testo: #9c3844; }
    .node[id*="-Annullata-"] { --stato-sfondo: #edf1ef; --stato-testo: #3a545e; }
    .node.statediagram-state rect { fill: var(--stato-sfondo); stroke: var(--stato-testo); }
    .node.statediagram-state .text-inner-tspan { fill: var(--stato-testo); }
  themeVariables:
    fontFamily: "Arial"
    fontSize: "14px"
    primaryColor: "#E9F2FC"
    primaryBorderColor: "#5480B0"
    primaryTextColor: "#172B3A"
    textColor: "#172B3A"
    lineColor: "#64748B"
    stateBkg: "#E9F2FC"
    stateBorder: "#5480B0"
    compositeBackground: "#F7FAFE"
    altBackground: "#E9F2FC"
    labelBackgroundColor: "#FFFFFF"
    edgeLabelBackground: "#F7FAFE"
---
stateDiagram-v2
    direction TB
    accTitle: PICUS - Stati della richiesta
    accDescr: Protocollo dei comandi di RichiesteApi. Gli stati e le transizioni seguono ADR-002.

    state "Stati da cui si può annullare" as Annullabile
    state Annullabile {
        direction LR
        state "Presa in carico" as Carico
        state "In programmazione" as Programmazione

        [*] --> Creata
        Creata --> Carico: [Banco]<br/>prendiInCarico() /<br/>[ricerca consentita]
        Carico --> Programmazione: [Banco e disponibilità valida]<br/>assegnaErogatore() /<br/>[erogatore assegnato]
        Programmazione --> Confermata: [Banco e accordo valido]<br/>confermaAccordo() /<br/>[accordo consultabile]
        Carico --> Rifiutata: [Banco, opzioni<br/>esaurite]<br/>rifiutaRichiesta() /<br/>[fuori dalla coda]
        Programmazione --> Rifiutata: [Banco e accordo impraticabile]<br/>rifiutaRichiesta() /<br/>[fuori dalla coda]
    }

    [*] --> Annullabile
    Annullabile --> Annullata: [account autorizzato,<br/>motivo se richiesto]<br/>annullaRichiesta() /<br/>[dettagli conservati]
