          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="label-2" value="Misure svolte e disponibilità come erogatrice&lt;br&gt;Richiesta di misura senza dati identificativi degli assistiti&lt;br&gt;Risposta sulla disponibilità all'erogazione&lt;br&gt;Dati quantitativi per misura e categoria, riferiti a un periodo&lt;br&gt;Conferma di ricezione delle comunicazioni del Banco&lt;br&gt;Evento eccezionale e motivo per l'annullamento dei propri erogatori" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;fontSize=23;fontSize=21;fillColor=none;strokeColor=none;" vertex="1" parent="1">
