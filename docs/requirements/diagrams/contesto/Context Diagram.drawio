        <mxCell id="note-0" value="Assistiti senza accesso né dati identificativi. Ministero: inserimento manuale del Banco, nessuna integrazione." style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;fontSize=23;fontSize=19;fillColor=none;strokeColor=none;" vertex="1" parent="1">
