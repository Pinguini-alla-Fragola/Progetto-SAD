        <mxCell id="note-1" value="Volontari e personale delle OPT senza account. Il Banco concorda i dettagli con l'erogatore e conferma: nessuna approvazione dell'erogatore o dell'OPT nell'app." style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;fontSize=23;fontSize=19;fillColor=none;strokeColor=none;" vertex="1" parent="1">
