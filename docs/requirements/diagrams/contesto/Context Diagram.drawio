          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="label-1" value="Vista complessiva richieste e stato degli scambi di servizio&lt;br&gt;Erogatori compatibili con ordine suggerito (comune, confinanti, appuntamenti)&lt;br&gt;Risposte degli erogatori alle richieste di disponibilità&lt;br&gt;Conferme di ricezione delle comunicazioni&lt;br&gt;Schede trimestrali degli operatori del Banco e dati quantitativi delle OPT&lt;br&gt;(viste trimestrale e cumulativa) per la rendicontazione ministeriale" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;fontSize=23;fontSize=21;fillColor=none;strokeColor=none;" vertex="1" parent="1">
